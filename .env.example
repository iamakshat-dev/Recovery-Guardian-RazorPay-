# Recovery Guardian — environment configuration template
#
# Copy this file to `.env` and fill in real values locally.
# `.env` is gitignored and must NEVER be committed.
# Every value below is a placeholder — none of this is a real credential.

# Razorpay test-mode credentials (Day 11 integration)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Claude API key — explanation layer only, never in the decision path (Day 13)
ANTHROPIC_API_KEY=

# Explicit kill switch proving the policy engine has zero LLM dependency
LLM_ENABLED=false
